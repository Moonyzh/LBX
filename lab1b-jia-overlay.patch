+#!/usr/bin/env bash
+# Render config/dht-node-{a,b,c}.cvm.yaml from config/dht-node.cvm.template.yaml.
+#
+# Ring (fixed by the team, matches the --node_id flags in docker-compose.yml):
+#   node-a 0x10000000  predecessor 0xB0000000 (node-c)  successor node-b
+#   node-b 0x60000000  predecessor 0x10000000 (node-a)  successor node-c
+#   node-c 0xB0000000  predecessor 0x60000000 (node-b)  successor node-a
+#
+# Addresses come from NODE_A_IP / NODE_B_IP / NODE_C_IP, or from node-inventory.env
+# (copy node-inventory.example.env and fill NODE_A_HOST / NODE_B_HOST / NODE_C_HOST).
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+TEMPLATE="config/dht-node.cvm.template.yaml"
+INVENTORY="${NODE_INVENTORY:-node-inventory.env}"
+
+if [[ ! -f "$TEMPLATE" ]]; then
+  echo "missing template: $TEMPLATE" >&2
+  exit 2
+fi
+
+# env vars win; otherwise load the local inventory file
+if [[ -z "${NODE_A_IP:-}" || -z "${NODE_B_IP:-}" || -z "${NODE_C_IP:-}" ]]; then
+  if [[ -f "$INVENTORY" ]]; then
+    # shellcheck disable=SC1090
+    set -a && . "$INVENTORY" && set +a
+    NODE_A_IP="${NODE_A_IP:-${NODE_A_HOST:-}}"
+    NODE_B_IP="${NODE_B_IP:-${NODE_B_HOST:-}}"
+    NODE_C_IP="${NODE_C_IP:-${NODE_C_HOST:-}}"
+  fi
+fi
+
+missing=0
+for name in NODE_A_IP NODE_B_IP NODE_C_IP; do
+  value="${!name:-}"
+  if [[ -z "$value" || "$value" == "<"*">" ]]; then
+    echo "需要 $name（三台机器的互通地址）；可直接 export，或写进 $INVENTORY" >&2
+    missing=1
+  fi
+done
+[ "$missing" -eq 0 ] || exit 2
+
+render() {
+  local letter="$1" node="$2" admin_port="$3" successor="$4" successor_host="$5"
+  local out="config/dht-node-${letter}.cvm.yaml"
+
+  sed -e "s/__NODE_NAME__/${node}/g" \
+      -e "s/__ADMIN_PORT__/${admin_port}/g" \
+      -e "s/__SUCCESSOR_NAME__/${successor}/g" \
+      -e "s/__SUCCESSOR_HOST__/${successor_host}/g" \
+      "$TEMPLATE" > "$out"
+
+  if grep -q "__" "$out"; then
+    echo "占位符未替换干净: $out" >&2
+    exit 3
+  fi
+  echo "generated ${out}  node=${node}  successor=trpc.dht.${successor}.DhtService -> ${successor_host}:19001"
+}
+
+render a node-a 18081 node-b "$NODE_B_IP"
+render b node-b 18082 node-c "$NODE_C_IP"
+render c node-c 18083 node-a "$NODE_A_IP"
+
+echo
+echo "ring: node-a(0x10000000) -> node-b(0x60000000) -> node-c(0xB0000000) -> node-a"
+echo "三台机器各自的互通地址：A=${NODE_A_IP} B=${NODE_B_IP} C=${NODE_C_IP}"
--- a/scripts/dht-up-node.sh
+++ b/scripts/dht-up-node.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+# Start exactly one DHT node on this machine, plus pricing and trip on machine A.
+#
+#   machine A: bash scripts/dht-up-node.sh a     # dht-node-a + pricing + trip
+#   machine B: bash scripts/dht-up-node.sh b     # dht-node-b only
+#   machine C: bash scripts/dht-up-node.sh c     # dht-node-c only
+#
+# Requires the three reachable addresses: export NODE_A_IP / NODE_B_IP / NODE_C_IP
+# (or keep them in node-inventory.env).
+set -euo pipefail
+
+NODE="${1:-}"
+case "$NODE" in
+  a|b|c) ;;
+  *)
+    echo "usage: bash scripts/dht-up-node.sh a|b|c" >&2
+    exit 2
+    ;;
+esac
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+IMAGE="lab1-ride-microservices:local"
+
+# 1. Render this machine's node config (re-renders all three, harmless).
+bash scripts/dht-gen-config.sh
+
+for f in pricing-service trip-service; do
+  [[ -f "config/${f}.yaml" ]] || { echo "missing config/${f}.yaml" >&2; exit 2; }
+done
+
+# 2. Every machine needs the shared image locally: B and C only run dht_server,
+#    but they still start it from the same image.
+if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
+  echo "image ${IMAGE} not found locally, building it (first run takes a few minutes)"
+  (cd docker && docker compose build pricing)
+fi
+
+# 3. Start only this machine's services.
+cd docker
+if [[ "$NODE" == "a" ]]; then
+  # trip-service enters the ring at node-a, so pricing and trip live here too.
+  docker compose up -d dht-node-a pricing trip
+else
+  docker compose up -d "dht-node-${NODE}"
+fi
+
+sleep 2
+docker compose ps
+
+echo
+echo "successor target in this machine's node config:"
+grep "target:" "${ROOT}/config/dht-node-${NODE}.cvm.yaml" || true
+
+cat <<EOF
+
+下一步：
+  * 三台都启动后，在机器 A 上执行  bash scripts/dht-verify.sh
+  * 查看本机节点日志        docker compose logs -f dht-node-${NODE}
+EOF

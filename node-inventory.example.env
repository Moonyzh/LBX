# Copy this file to node-inventory.env for local use. Do not commit the copy.
# Use private/reachable addresses as appropriate for your VPC; never place
# account passwords, SSH private keys, API keys, or registry credentials here.

NODE_A_NAME=node-a
NODE_A_HOST=<NODE_A_PRIVATE_IP>
NODE_A_PORT=19001
NODE_A_ID=<UNSIGNED_32_BIT_ID>

NODE_B_NAME=node-b
NODE_B_HOST=<NODE_B_PRIVATE_IP>
NODE_B_PORT=19001
NODE_B_ID=<UNSIGNED_32_BIT_ID>

NODE_C_NAME=node-c
NODE_C_HOST=<NODE_C_PRIVATE_IP>
NODE_C_PORT=19001
NODE_C_ID=<UNSIGNED_32_BIT_ID>
